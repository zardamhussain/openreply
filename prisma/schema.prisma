// ManyChat Alternative — B2B Instagram Comment → DM SaaS schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  sentInvitations   WorkspaceInvitation[] @relation("WorkspaceInvitationsSent")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usagePeriodStart  DateTime @default(now())
  dmsSentThisPeriod Int      @default(0)

  zernioConnections ZernioConnection[]
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  socialAccounts    SocialAccount[]
  automations       Automation[]
  deliveryLogs      DeliveryLog[]
  trackedLinks      TrackedLink[]
  linkClicks        LinkClick[]
  webhookEvents     WebhookEvent[]
  operationalEvents OperationalEvent[]
  serviceKeys       ServiceKey[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model ServiceKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  scopes      String[]
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model WorkspaceInvitation {
  id              String                    @id @default(cuid())
  workspaceId     String
  email           String
  role            WorkspaceRole             @default(MEMBER)
  token           String                    @unique
  status          WorkspaceInvitationStatus @default(PENDING)
  invitedByUserId String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("WorkspaceInvitationsSent", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email])
  @@index([workspaceId])
  @@index([status])
}

/// A social account connected to a workspace.
///
/// Instagram and Threads accounts share one table because a campaign, its
/// delivery log and its link clicks all point at "the account this belongs
/// to". The platform decides which API the account is driven through:
/// Instagram through the Instagram Graph API, Threads through graph.threads.com.
///
/// `platformUserId` is the account id on its own platform — the Instagram
/// professional account id (IGSID) on Instagram, the app-scoped user id on
/// Threads. The two live in different id spaces, so identity is unique per
/// platform rather than globally.
model SocialAccount {
  id                String         @id @default(cuid())
  workspaceId       String
  platform          SocialPlatform @default(INSTAGRAM)
  platformUserId    String
  username          String
  name              String?
  provider          AccountProvider @default(META)
  zernioAccountId   String?
  zernioConnectionId String?
  accessToken       String
  tokenExpiresAt    DateTime?
  webhookSubscribed Boolean        @default(false)
  connectedAt       DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automations       Automation[]
  deliveryLogs      DeliveryLog[]
  linkClicks        LinkClick[]
  followerSnapshots FollowerSnapshot[]
  zernioConnection  ZernioConnection? @relation(fields: [zernioConnectionId], references: [id], onDelete: SetNull)

  @@unique([platform, platformUserId])
  @@index([workspaceId])
  @@index([zernioConnectionId])
}

/// Daily follower total for one account. Instagram only retains ~30 days of
/// account insights, so history beyond that window exists only because we
/// record it here. One row per account per day.
model FollowerSnapshot {
  id                 String   @id @default(cuid())
  socialAccountId    String
  /// Midnight UTC of the day this count belongs to.
  date               DateTime @db.Date
  followersCount     Int
  /// True when the row was reconstructed from follower_count insight deltas
  /// rather than observed directly, so it can be corrected later.
  backfilled         Boolean  @default(false)
  createdAt          DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, date])
  @@index([socialAccountId])
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  socialAccountId    String

  name           String
  goal           String?
  postId         String?
  postUrl        String?
  pendingNextReel Boolean @default(false)
  matchAnyPost   Boolean @default(false)
  keywords       String[]
  matchAnyWord   Boolean @default(false)
  // Also fire this campaign when someone sends a DM whose text matches the
  // keywords above. Independent of the post trigger — a DM has no media, so
  // postId / matchAnyPost do not apply to it.
  dmTriggerEnabled Boolean @default(false)
  // The campaign's response message. On Instagram it is delivered as a private
  // DM; on Threads it is published as a reply to the comment. The column name
  // is retained from the Instagram-only era.
  dmMessage      String
  openingDmEnabled     Boolean @default(false)
  openingDmMessage     String?
  openingDmButtonLabel String?
  linkButtonLabel      String?
  requireFollow           Boolean @default(false)
  followPromptMessage     String?
  followPromptButtonLabel String?
  followUpEnabled Boolean @default(false)
  followUpMessage String?
  // Minutes to wait after the link is delivered before sending the follow-up.
  // 0 sends it right away.
  followUpDelayMinutes Int @default(0)
  publicReplyEnabled Boolean @default(false)
  publicReplyMessage String?
  publicReplyMessages String[] @default([])
  isActive       Boolean @default(true)
  wholeWordMatch Boolean @default(true)
  reportShareSlug    String? @unique
  reportShareEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  deliveryLogs  DeliveryLog[]
  trackedLinks  TrackedLink[]
  linkClicks    LinkClick[]

  @@index([workspaceId])
  @@index([socialAccountId])
  @@index([postId])
}

/// One delivery record for one comment on one campaign.
///
/// `status` / `sentAt` describe the campaign's primary response: the private
/// DM on Instagram, the published reply on Threads. `publicReplySentAt` and
/// its siblings describe the separate public-comment-reply leg, which only
/// Instagram campaigns can combine with a DM.
model DeliveryLog {
  id                 String     @id @default(cuid())
  workspaceId        String
  automationId       String
  socialAccountId    String

  commenterId   String
  commenterName String?
  commentText   String
  commentId     String
  matchedKeyword String?
  status        DeliveryStatus @default(PENDING)
  attempts      Int      @default(0)
  sentAt        DateTime?
  errorMessage  String?

  // The public comment reply is delivered independently of the DM, so its
  // outcome is tracked separately. publicReplySentAt makes it idempotent across
  // retries; a DM failure never blocks or re-posts the public reply.
  deliveryUnconfirmed Boolean @default(false)
  publicReplyDeliveryUnconfirmed Boolean @default(false)
  publicReplySentAt DateTime?
  publicReplyError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation    Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId])
  @@index([workspaceId])
  @@index([automationId])
  @@index([socialAccountId])
  @@index([status])
}

// Legacy reconciliation model; currently unwired. Runtime code does not read
// or write ProcessedComment. Current reconciliation dedup uses owner-reply
// checks and DeliveryLog guards instead.
model ProcessedComment {
  id                 String   @id @default(cuid())
  socialAccountId    String
  commentId          String   @unique
  source             String // "WEBHOOK" | "POLLING"
  seenAt             DateTime @default(now())

  @@index([socialAccountId])
}

model TrackedLink {
  id             String   @id @default(cuid())
  workspaceId    String
  automationId   String
  slug           String   @unique
  label          String?
  destinationUrl String
  // Which DM button this link is, starting at 0. Read links with
  // TRACKED_LINK_ORDER (lib/tracking/link-order.ts), never by createdAt alone:
  // links saved in one request share a createdAt, and Postgres returns tied
  // rows in no fixed order.
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)
  clicks     LinkClick[]

  @@index([workspaceId])
  @@index([automationId])
}

model LinkClick {
  id                 String   @id @default(cuid())
  workspaceId        String
  automationId       String
  socialAccountId    String
  trackedLinkId      String
  ipHash             String?
  // Token from the link's `?r=` (hashRecipientId), set on links sent in a DM.
  // Clicks are counted once per recipient, falling back to ipHash without it.
  recipientHash      String?
  userAgent          String?
  referrer           String?
  createdAt          DateTime @default(now())

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  automation    Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  trackedLink   TrackedLink    @relation(fields: [trackedLinkId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([automationId])
  @@index([socialAccountId])
  @@index([trackedLinkId])
  @@index([createdAt])
  @@index([workspaceId, createdAt])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  workspaceId String?
  object      String?
  payload     Json
  status      WebhookStatus @default(PENDING)
  errorMessage String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
}

model OperationalEvent {
  id          String                @id @default(cuid())
  workspaceId String?
  source      OperationalEventSource
  level       OperationalEventLevel @default(INFO)
  message     String
  payload     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([source])
  @@index([level])
  @@index([createdAt])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED_DEDUP
  SKIPPED_RATE_LIMIT
  SKIPPED_PLAN_LIMIT
  SKIPPED_NO_MATCH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
}

enum OperationalEventSource {
  WORKER
  TOKEN_REFRESH
  HEALTH
  SYSTEM
}

enum OperationalEventLevel {
  INFO
  WARNING
  ERROR
}


enum SocialPlatform {
  INSTAGRAM
  THREADS
}

enum AccountProvider {
  META
  ZERNIO
}

model ZernioConnection {
  id            String   @id @default(cuid())
  workspaceId   String
  apiKey        String
  label         String?
  profileId     String?
  webhookId     String?
  webhookSecret String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accounts      SocialAccount[]

  @@index([workspaceId])
}

// Claims persist independently of BullMQ retention so old taps never resend.
model PostbackDelivery {
  id String @id
  createdAt DateTime @default(now())
}
